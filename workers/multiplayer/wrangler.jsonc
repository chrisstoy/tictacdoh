{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tictacdoh-multiplayer",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-12",
  "compatibility_flags": ["nodejs_compat"],
  // Optional comma-separated extra origins (defaults include Capacitor schemes + Pages Origin).
  // WEB_JOIN_BASE: PWA origin+path for /join landing fallback (?join=), no trailing slash.
  "vars": {
    "CORS_ORIGINS": "",
    "WEB_JOIN_BASE": "https://chrisstoy.github.io/tictacdoh"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ]
}
