{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/assets/*": [
        "assets/*"
      ],
      "@shared/*": [
        "shared/*"
      ]
    }
  },
  "exclude": [
    "workers",
    "node_modules",
    "dist",
    "android",
    "ios"
  ]
}